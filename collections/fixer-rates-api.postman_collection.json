          "id": "4ea8a3c5-87ca-4c34-a516-020c92686217",
          "name": "Get Historical Exchange Rates",
          "request": {
            "name": "Get Historical Exchange Rates",
            "description": {
              "content": "Returns end-of-day historical exchange rates for any date since 1999. Historical\ndata is available on all plans, including Free.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":date"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "base",
                  "value": "<string>",
                  "description": "Three-letter ISO 4217 base currency code. Defaults to EUR on the Free plan;\nany base currency may be selected on Basic plan and above.\n"
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<date>",
                  "key": "date",
                  "description": "(Required) ISO-8601 date in `YYYY-MM-DD` format (any working day since 1999-01-04)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
