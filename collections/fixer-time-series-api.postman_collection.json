          "name": "Get Time Series Exchange Rates",
          "request": {
            "name": "Get Time Series Exchange Rates",
            "description": {
              "content": "Returns daily historical exchange rates between two dates of your choice,\nwith a maximum range of 365 days. Available on Professional plan and above.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Start date for the time series window (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) End date for the time series window (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "base",
                  "value": "<string>",
                  "description": "Three-letter ISO 4217 base currency code. Defaults to EUR on the Free plan;\nany base currency may be selected on Basic plan and above.\n"
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set."
                }
              ],
              "variable": []
