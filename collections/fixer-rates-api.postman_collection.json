          "name": "Get Latest Exchange Rates",
          "request": {
            "name": "Get Latest Exchange Rates",
            "description": {
              "content": "Returns the most recent exchange rate data. Rates update hourly on the Free and\nBasic tiers, every 10 minutes on Professional, and every 60 seconds on\nProfessional Plus and Enterprise.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "latest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "base",
                  "value": "<string>",
                  "description": "Three-letter ISO 4217 base currency code. Defaults to EUR on the Free plan;\nany base currency may be selected on Basic plan and above.\n"
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set."
                }
