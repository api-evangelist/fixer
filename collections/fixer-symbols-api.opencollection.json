{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fixer Conversion Symbols API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Symbols",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Supported Currency Symbols",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apilayer.com/fixer/symbols"
          },
          "docs": "Returns all currency symbols Fixer supports along with their full names."
        }
      ]
    }
  ],
  "bundled": true
}