      "name": "fluctuation",
      "item": [
        {
          "name": "Get Fluctuation Data",
          "id": "596744a9-adf3-4cb4-9a82-7dc962fe0a44",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fluctuation?start_date=<date>&end_date=<date>&base=<string>&symbols=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fluctuation"
              ],
              "query": [
                {
                  "description": "(Required) Start date for the fluctuation window (YYYY-MM-DD).",
                  "key": "start_date",
                  "value": "<date>"
                },
                {
                  "description": "(Required) End date for the fluctuation window (YYYY-MM-DD).",
                  "key": "end_date",
                  "value": "<date>"
                },
                {
                  "description": "Three-letter ISO 4217 base currency code. Defaults to EUR on the Free plan;\nany base currency may be selected on Basic plan and above.\n",
                  "key": "base",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set.",
                  "key": "symbols",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns fluctuation data (start rate, end rate, change, change_pct) between two\ndates for any supported currency pair. Available on Professional Plus and above.\n"
          },
