{
  "info": {
    "_postman_id": "821cae94-2dd1-48d5-a072-94ac6ad4d3ee",
    "name": "Fixer Conversion Fluctuation API",
    "description": "Fixer is a lightweight JSON API for real-time and historical foreign exchange\nrates and currency conversion. Sourced primarily from the European Central Bank\nand 15+ other exchange rate data providers, Fixer supports 170+ world currencies.\n\nThe API is delivered via the APILayer marketplace. All requests authenticate via\nan `apikey` HTTP header. The free tier is limited to 100 requests per month and\nis HTTP-only; HTTPS encryption and source-currency switching become available on\nthe Basic plan and above.\n\n\nContact Support:\n Name: Fixer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:40:06.000Z",
    "updatedAt": "2026-07-28T01:40:06.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-821cae94-2dd1-48d5-a072-94ac6ad4d3ee"
  },
  "item": [
