      "item": [
        {
          "name": "Get Time Series Exchange Rates",
          "id": "89aa0fdd-738a-47bf-8634-8740b5b604a6",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/timeseries?start_date=<date>&end_date=<date>&base=<string>&symbols=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "timeseries"
              ],
              "query": [
                {
                  "description": "(Required) Start date for the time series window (YYYY-MM-DD).",
                  "key": "start_date",
                  "value": "<date>"
                },
                {
                  "description": "(Required) End date for the time series window (YYYY-MM-DD).",
                  "key": "end_date",
                  "value": "<date>"
                },
                {
                  "description": "Three-letter ISO 4217 base currency code. Defaults to EUR on the Free plan;\nany base currency may be selected on Basic plan and above.\n",
                  "key": "base",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set.",
                  "key": "symbols",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns daily historical exchange rates between two dates of your choice,\nwith a maximum range of 365 days. Available on Professional plan and above.\n"
