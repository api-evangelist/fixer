      "item": [
        {
          "id": "b3933818-1873-4f25-8b9c-4200588b462e",
          "name": "Get Fluctuation Data",
          "request": {
            "name": "Get Fluctuation Data",
            "description": {
              "content": "Returns fluctuation data (start rate, end rate, change, change_pct) between two\ndates for any supported currency pair. Available on Professional Plus and above.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fluctuation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Start date for the fluctuation window (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) End date for the fluctuation window (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "base",
                  "value": "<string>",
                  "description": "Three-letter ISO 4217 base currency code. Defaults to EUR on the Free plan;\nany base currency may be selected on Basic plan and above.\n"
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
