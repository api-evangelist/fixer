{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fixer Conversion API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Convert Currency Amount",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apilayer.com/fixer/convert",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Three-letter source currency code (ISO 4217)."
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Three-letter target currency code (ISO 4217)."
              },
              {
                "name": "amount",
                "value": "",
                "type": "query",
                "description": "Amount to convert."
              },
              {
                "name": "date",
                "value": "",
                "type": "query",
                "description": "Optional historical date (YYYY-MM-DD) to use for the conversion rate."
              }
            ]
          },
          "docs": "Converts an amount from one currency to another using real-time or historical\nrates. Available on Basic plan and above.\n"
        }
      ]
    }
  ],
  "bundled": true
}